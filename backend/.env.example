# Server
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string. With Supabase: Project > Connect > Transaction pooler
# (port 6543), then put your database password where it says [YOUR-PASSWORD].
DATABASE_URL=

# Stripe (leave STRIPE_SECRET_KEY empty to use the built-in mock checkout for local dev only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Share of each payment kept by the platform, in percent
PLATFORM_FEE_PERCENT=15
